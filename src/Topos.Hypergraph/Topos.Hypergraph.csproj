<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- SparseSet<T> is internal (locked M8, see docs/DECISIONS.md) but SparseSetTests /
         SparseSetFuzzTests and the SparseSet-vs-Dictionary benchmark construct it directly,
         rather than only through the public IHypergraphQuery/HypergraphKernel surface. -->
    <InternalsVisibleTo Include="Topos.Hypergraph.Tests" />
    <InternalsVisibleTo Include="Topos.Hypergraph.Benchmarks" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Topos.Hypergraph</RootNamespace>
    <AssemblyName>Topos.Hypergraph</AssemblyName>
    <PackageId>Topos.Hypergraph</PackageId>
    <Description>
      Embedded, in-process, typed-property hypergraph kernel for C#, purpose-fit for
      long-lived adaptive symbolic memory workloads (AI/agent memory). Four-primitive storage
      contract (Handle/Vertex/Incidence/PropertyKey&lt;T&gt;), ~40 default-implemented traversal
      and analytics algorithms (BFS/DFS/shortest-path/cycle/SCC/s-walk/community detection),
      reification, composable views, embeddings, and learnable edges (M0-M6).
    </Description>
    <Authors>Nasser Towfigh</Authors>
    <Copyright>Copyright © 2026 Nasser Towfigh</Copyright>
    <Version>0.1.0-m8</Version>
  </PropertyGroup>

</Project>
