<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- SparseSet<T> is internal (locked M8, see docs/DECISIONS.md) but SparseSetTests /
         SparseSetFuzzTests and the SparseSet-vs-Dictionary benchmark construct it directly,
         rather than only through the public IHypergraphQuery/HypergraphKernel surface. -->
    <InternalsVisibleTo Include="Topos.Hypergraph.Tests" />
    <InternalsVisibleTo Include="Topos.Hypergraph.Benchmarks" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Topos.Hypergraph</RootNamespace>
    <AssemblyName>Topos.Hypergraph</AssemblyName>
    <PackageId>Topos.Hypergraph</PackageId>
    <Description>
      Embedded, in-process, typed-property hypergraph kernel for C#, purpose-fit for
      long-lived adaptive symbolic memory workloads (AI/agent memory). Four-primitive storage
      contract (Handle/Vertex/Incidence/PropertyKey&lt;T&gt;), ~40 default-implemented traversal
      and analytics algorithms (BFS/DFS/shortest-path/cycle/SCC/s-walk/community detection/
      centrality/PageRank), reification, composable views, embeddings, and learnable edges
      (M0-M6, M11 phase 1).
    </Description>
    <Authors>Nasser Towfigh</Authors>
    <Copyright>Copyright © 2026 Nasser Towfigh</Copyright>
    <!-- Prerelease suffix is DOT-separated (`-m.11`, not `-m11`) — required, not cosmetic.
         SemVer 2.0 compares an undotted `m11` as one alphanumeric identifier in ASCII order,
         so `m11` sorts BELOW `m8` and `m10` below `m9`. Dotting it makes the numeric part its
         own identifier, which is compared numerically. The base version moved 0.1.0 → 0.2.0 in
         the same change because every `m.N` sorts below every already-published `mN`, so the
         minor bump is what actually clears the previously-published set. See docs/DECISIONS.md
         2026-08-03 "NUGET VERSION SCHEME CORRECTED". -->
    <Version>0.2.0-m.11</Version>
    <!-- License: SPDX expression. NuGet.org renders this; no file-bundling needed. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Source repo: lets consumers trace the package back to this code. -->
    <RepositoryUrl>https://github.com/Minu476/Topos.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Project page on nuget.org's "Project website" link. -->
    <PackageProjectUrl>https://github.com/Minu476/Topos</PackageProjectUrl>
    <!-- Discoverability: these show up in nuget.org search and package listings. -->
    <PackageTags>hypergraph;ai-memory;agent-memory;llm;knowledge-graph;csharp;graph;incidence;n-ary</PackageTags>
    <!-- Optional but recommended: render the repo README on the nuget.org package page. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
